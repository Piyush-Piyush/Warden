{
  "name": "warden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An incident-response agent that investigates, reproduces, and proposes fixes for production alerts, and asks before acting.",
  "workspaces": [
    "shared",
    "mcp/ops-server",
    "server",
    "dashboard"
  ],
  "scripts": {
    "dev:ops-mcp": "npm run dev -w mcp/ops-server",
    "dev:server": "npm run dev -w server",
    "dev:dashboard": "npm run dev -w dashboard",
    "register-agent": "tsx --env-file=.env scripts/register-agent.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "send-alert": "tsx --env-file=.env scripts/send-alert.ts",
    "probe:trueforge": "tsx --env-file=.env scripts/probe-trueforge.ts",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
