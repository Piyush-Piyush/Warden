# TrueForge server this project talks to. Run it via Docker Compose (see
# README.md); the host-mapped port is 8791, not TrueForge's internal 8790.
TRUEFORGE_BASE_URL=http://localhost:8791

# Model to run the agent with, and the name it's registered under.
AGENT_MODEL=google-gemini/gemini-3-6-flash
AGENT_NAME=incident-responder

# Which project the ops-mcp server and webhook default to. Resolves to
# demo/<name> for local dev/demo use; a real deployment points
# OPS_MCP_PROJECT_DIR / PROJECTS_DIR at its own project directory instead,
# which does not have to live inside this repo at all.
DEFAULT_PROJECT=sample-checkout
# OPS_MCP_PROJECT_DIR=demo/sample-checkout
# PROJECTS_DIR=demo

# ops-mcp server
OPS_MCP_PORT=4000
OPS_MCP_ADMIN_URL=http://localhost:4000
# Hostnames (no ports) allowed to reach ops-mcp: DNS-rebinding protection.
# Must include the Docker service name it's reached by on shared networks.
OPS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,warden-ops-mcp

# Webhook/case API server
SERVER_PORT=4100
SERVER_BASE_URL=http://localhost:4100
# CASE_STORE_DB_PATH=./server/warden.sqlite

# Dashboard (Vite reads VITE_-prefixed vars directly, not the ones above)
DASHBOARD_PORT=5173
VITE_SERVER_BASE_URL=http://localhost:4100
VITE_TRUEFORGE_BASE_URL=http://localhost:8791
