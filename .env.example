# TrueForge server this project talks to (run `npx @truefoundry/trueforge@latest` locally)
TRUEFORGE_BASE_URL=http://localhost:8790

# Port the local ops MCP server listens on
OPS_MCP_PORT=4000
OPS_MCP_BASE_URL=http://localhost:4000

# Which project the ops MCP server and webhook default to. Resolves to demo/<name>
# for local dev/demo use; a real deployment points this at its own project directory
# (which does not have to live inside this repo at all).
DEFAULT_PROJECT=sample-checkout
DEFAULT_PROJECT_DIR=demo/sample-checkout

# Port the webhook/case API server listens on
SERVER_PORT=4100

# Port the optional dashboard dev server listens on
DASHBOARD_PORT=5173
